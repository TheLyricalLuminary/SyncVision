generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["scoring"]
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  planLevel          String              @default("COMPOSER")
  createdAt          DateTime            @default(now())
  stripeCustomerId   String?
  creditBalance      Int                 @default(0)
  ownedCatalogs      Catalog[]           @relation("CatalogOwner")
  catalogMembers     CatalogMember[]
  creditTransactions CreditTransaction[]

  @@schema("scoring")
}

model Catalog {
  id        String          @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime        @default(now())
  owner     User            @relation("CatalogOwner", fields: [ownerId], references: [id])
  members   CatalogMember[]
  tracks    Track[]

  @@schema("scoring")
}

model CatalogMember {
  id        String  @id @default(cuid())
  catalogId String
  userId    String
  role      String
  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([catalogId, userId])
  @@schema("scoring")
}

model Track {
  id               String           @id @default(cuid())
  title            String
  artistName       String?
  isrc             String?
  acoustidId       String?
  acoustidScore    Float?
  acoustidCheckedAt DateTime?
  trackStatus      String           @default("uploaded")
  audioFilePath    String?
  isSynthetic      Boolean   @default(true)
  processedAt      DateTime?
  confidence       Float?
  timeline         Json?
  errorReason      String?
  tempo            Float?
  tonalCharacter   String?
  energyCharacter  String?
  catalogId        String?
  modelVersion     String?
  rmsEnergy        Float?
  spectralCentroid Float?
  zeroCrossingRate Float?
  lyricsText       String?
  lyricsState      String?   // FULL | INSTRUMENTAL | UNAVAILABLE
  lyricsSource     String?   // lrclib | lyrics_ovh
  isArchived       Boolean   @default(false)
  confidenceScore  ConfidenceScore?
  rightsProfile    RightsProfile?
  mirrorFingerprint MirrorFingerprint?
  catalog          Catalog?         @relation(fields: [catalogId], references: [id])

  @@unique([catalogId, isrc], map: "catalog_isrc_unique")
  @@map("ScoringTrack")
  @@schema("scoring")
}

model MirrorFingerprint {
  id              String   @id @default(cuid())
  trackId         String   @unique
  track           Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  coarseEnvelope  Json
  bandStats       Json
  fullTimeline    Json
  durationSeconds Float
  frameCount      Int
  fps             Int
  inputHash       String
  modelVersion    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("mirror_fingerprints")
  @@schema("scoring")
}

model RightsProfile {
  id                    String    @id @default(cuid())
  trackId               String    @unique
  ascapWorkId           String?
  masterOwnershipPct    Decimal?
  splitPct              Decimal?
  isOneStop             Boolean?
  writerName            String?
  writerIpi             String?
  publisherName         String?
  proAffiliation        String?
  bmiWorkId             String?
  masterOwnedBy         String?
  masterOwnershipSplits Json?
  masterOwnershipType   String?
  masterVerifiedAt      DateTime?
  rightsState           String?
  rightsLastCheckedAt   DateTime?
  syncLicenseStatus     String?
  syncLicensedBy        String?
  lyricLicenseStatus    String?
  lyricLicensedBy       String?
  enrichmentSources     String[]
  enrichedAt            DateTime?
  territory             String?
  explicitFlag          Boolean?
  workId                String?
  genreTags             String[]
  popularityScore       Int?
  enrichmentStatus      String?   @default("pending")
  iswc                  String?
  workMbid              String?
  rightsFieldSources    Json?
  track                 Track     @relation(fields: [trackId], references: [id])

  @@schema("scoring")
}

model ConfidenceScore {
  id                String   @id @default(cuid())
  trackId           String   @unique
  score             Int
  confidenceLabel   String
  inputHash         String
  rightsBreakdown   Int
  metaBreakdown     Int
  audioBreakdown    Int
  sceneFitBreakdown Int
  explanation       String
  createdAt         DateTime @default(now())
  hashVersion       Int      @default(1)
  track             Track    @relation(fields: [trackId], references: [id])

  @@schema("scoring")
}

model StripeEvent {
  eventId   String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("stripe_events")
  @@schema("scoring")
}

model UserTrial {
  trialToken String   @id @default(cuid())
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  tracksUsed Int      @default(0)
  scenesUsed Int      @default(0)

  @@map("user_trials")
  @@schema("scoring")
}

model StripeEventLedger {
  id              String    @id
  type            String
  processed       Boolean   @default(false)
  processingError String?
  source          String
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([processed])
  @@index([type])
  @@map("stripe_event_ledger")
  @@schema("scoring")
}

model StripeAuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  action    String
  result    String
  metadata  Json
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([action])
  @@map("stripe_audit_log")
  @@schema("scoring")
}

/// Also the Placement Decision Record. A row is a share packet (expiring) or
/// a placement (permanent, isPlacement=true) — one model, per the consolidation
/// directive's rule against competing decision structures. Placement fields are
/// nullable so every existing share packet stays valid unchanged.
model DecisionPacket {
  id             String   @id @default(cuid())
  packetVersion  String   @default("1")
  scoringVersion String
  briefId        String
  briefText      String
  sceneParams    Json
  tracks         Json
  packetHash     String
  /// Share-packet TTL. Placement rows (isPlacement=true) are exempt from the
  /// expiry check via that flag rather than a null here — keeping this NOT fULL
  /// avoids breaking the six share.ts call sites that read it directly.
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  directorDecisions Json?  @map("director_decisions")

  /// True when this row is a Placement Decision rather than a share packet.
  isPlacement      Boolean  @default(false) @map("is_placement")
  sceneId          String?  @map("scene_id")
  /// The supervisor's reference track (what the ediu is responding to).
  tempTrackId      String?  @map("temp_track_id")
  /// The track actually selected for placement.
  candidateTrackId String?  @map("candidate_track_id")
  /// Per-field rights provenance (SourcedValue[] + AgreementState). Promoted
  /// from routes/share.ts's inline build so iu is populated for every decision,
  /// not only shared ones.
  rightsFieldLedger Json?   @map("rights_field_ledger")
  /// Evidence-derived director explanation (preserved/changed/lands/rights).
  explanation      Json?
  decidedAt        DateTime? @map("decided_at")

  scene  Scene? @relation(fields: [sceneId], references: [id])
  cues   Cue[]

  @@index([isPlacement])
  @@index([sceneId])
  @@map("decision_packets")
  @@schema("scoring")
}

/// Scene DNA. The arc itself is stored as one JSON column matching the exact
/// SceneArc contract emiuted by scoring/arcExtraction.ts — that module stays
/// the single authority on arc shape, so nothing is duplicated or able to drift.
model Scene {
  id           String    @id @default(cuid())
  projectId    String?   @map("project_id")
  sceneNumber  String?   @map("scene_number")
  description  String?
  timecodeIn   String?   @map("timecode_in")
  timecodeOut  String?   @map("timecode_out")
  durationSec  Float?    @map("duration_sec")

  /// Full SceneArc as produced by arcExtraction.ts (opening/heldBreath/turn/
  /// release/curve/valenceCurve/narrativeCertainty/signals/events/inputHash/
  /// lexiconVersion). Never hand-ediued — supervisor edits go to overrides.
  sceneArc     Json?     @map("scene_arc")
  /// How the DNA was derived, per field where known: 'text' | 'recon' | 'manual'.
  derivedFrom  String?   @map("derived_from")
  /// Supervisor corrections, kept separate from derived values so the
  /// deterministic extraction stays auditable against its own output.
  overrides    Json?

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  decisions    DecisionPacket[]
  cues         Cue[]

  @@index([projectId])
  @@map("scenes")
  @@schema("scoring")
}

/// The downstream cue-sheet record. Derived from a placement decision — never
/// a separately maintained dataset. Composition and master rights stay in
/// distinct field groups, as clearance requires them tracked separately.
model Cue {
  id            String   @id @default(cuid())
  decisionId    String?  @map("decision_id")
  sceneId       String?  @map("scene_id")
  trackId       String?  @map("track_id")

  cueNumber     String?  @map("cue_number")
  sequence      Int?
  usageType     String?  @map("usage_type")
  musicSource   String?  @map("music_source")
  timeIn        String?  @map("time_in")
  timeOut       String?  @map("time_out")
  durationSec   Float?   @map("duration_sec")
  musicTitle    String?  @map("music_title")

  // composition side
  composerWriuer String? @map("composer_wriuer")
  publisher      String?
  pro            String?
  ipi            String?
  iswc           String?
  publishingShare Decimal? @map("publishing_share")

  // master side
  artist        String?
  label         String?
  masterOwner   String?  @map("master_owner")
  isrc          String?
  masterShare   Decimal? @map("master_share")

  // clearance
  syncStatus       String? @map("sync_status")
  masterStatus     String? @map("master_status")
  territory        String?
  media            String?
  term             String?
  licenseReference String? @map("license_reference")
  notes            String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  decision      DecisionPacket? @relation(fields: [decisionId], references: [id])
  scene         Scene?          @relation(fields: [sceneId], references: [id])

  @@index([decisionId])
  @@index([sceneId])
  @@index([trackId])
  @@map("cues")
  @@schema("scoring")
}

model CreditTransaction {
  id            String   @id @default(cuid())
  userId        String
  packId        String
  credits       Int
  stripeEventId String   @unique
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("credit_transactions")
  @@schema("scoring")
}
